@"
# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local uploads and temporary files
server/uploads/*
!server/uploads/.gitkeep
"@ | Set-Content .gitignore